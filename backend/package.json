{
	"name": "backend",
	"version": "0.1.0",
	"private": true,
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"lint": "biome check .",
		"lint:fix": "biome check --fix .",
		"format": "biome format --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply goal-coach-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply goal-coach-db --remote"
	},
	"dependencies": {
		"@clerk/backend": "^1",
		"drizzle-orm": "^0.44",
		"hono": "^4"
	},
	"devDependencies": {
		"@biomejs/biome": "^1",
		"@cloudflare/workers-types": "^4",
		"drizzle-kit": "^0.31",
		"typescript": "^5",
		"vitest": "^3",
		"wrangler": "^4"
	}
}
