{
  "name": "goal-coach-ai",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.23.0",
  "scripts": {
    "dev": "pnpm --filter frontend dev",
    "dev:backend": "pnpm --filter backend dev",
    "build": "pnpm --filter frontend build",
    "lint": "pnpm --filter frontend lint && pnpm --filter backend lint",
    "test": "pnpm --filter frontend test",
    "test:run": "pnpm --filter frontend test:run",
    "deploy:frontend": "pnpm --filter frontend run deploy",
    "deploy:backend": "pnpm --filter backend run deploy",
    "deploy": "pnpm run deploy:backend && pnpm run deploy:frontend"
  }
}
